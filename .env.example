# Copy this file to ".env" and fill in your key. The real .env is gitignored,
# so your key never leaves your machine.
#
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (macOS/Linux)
#
# The backend reads this automatically at startup, so you don't have to
# re-export variables in every new terminal.

# ---- Chat model -------------------------------------------------------
# groq (default, fastest) | gemini | openai | ollama (local, offline)
SAFESIGHT_LLM_PROVIDER=groq

# Free key, no card required: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional: override the model. Names change regularly on hosted platforms,
# so if you get a "model not found" error, check the provider's model list.
# SAFESIGHT_LLM_MODEL=openai/gpt-oss-120b

# Optional tuning. NUM_PREDICT caps answer length and is the most reliable
# lever on worst-case response time. NUM_CTX applies to Ollama only.
# SAFESIGHT_LLM_NUM_PREDICT=800
# SAFESIGHT_LLM_NUM_CTX=4096

# ---- Auth -------------------------------------------------------------
# Change this before any real-world use — it signs the login tokens.
# SAFESIGHT_SECRET_KEY=change-me
